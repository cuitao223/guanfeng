{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guanfeng public data adapter read response",
  "type": "object",
  "required": [
    "dataset",
    "grid",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "dataset": {
      "type": "object",
      "required": [
        "id",
        "name",
        "format",
        "kind",
        "source",
        "sha256",
        "timeStart",
        "timeEnd",
        "variables",
        "license"
      ],
      "properties": {
        "id": {
          "enum": [
            "era5-temperature",
            "goes16-c13"
          ]
        },
        "format": {
          "enum": [
            "grib",
            "netcdf"
          ]
        },
        "kind": {
          "const": "grid"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "grid": {
      "type": "object",
      "required": [
        "x",
        "y",
        "values",
        "unit",
        "variable",
        "missingValue",
        "sampling",
        "gridMapping"
      ],
      "properties": {
        "x": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "y": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "variable": {
          "enum": [
            "t",
            "z",
            "CMI"
          ]
        },
        "missingValue": {
          "const": 999
        },
        "sampling": {
          "type": "object",
          "required": [
            "method",
            "xStride",
            "yStride",
            "originalShape",
            "returnedShape",
            "interpolated"
          ],
          "properties": {
            "interpolated": {
              "const": false
            },
            "xStride": {
              "type": "integer",
              "minimum": 1
            },
            "yStride": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "gridMapping": {
          "type": "object"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "min",
        "max",
        "mean",
        "validCount",
        "missingCount",
        "totalCount",
        "missingValue",
        "statisticsScope",
        "fusionPerformed"
      ],
      "properties": {
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "mean": {
          "type": [
            "number",
            "null"
          ]
        },
        "validCount": {
          "type": "integer",
          "minimum": 0
        },
        "missingCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalCount": {
          "type": "integer",
          "minimum": 0
        },
        "missingValue": {
          "const": 999
        },
        "statisticsScope": {
          "const": "returned-grid"
        },
        "fusionPerformed": {
          "const": false
        }
      }
    }
  }
}
